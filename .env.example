# 本地开发环境变量
# 复制此文件为 .env.local 并填入实际值

# 本地 dev 时 AI 请求走代理（解决 CORS）
NEXT_PUBLIC_COZE_API_URL=http://localhost:3001/api/run

# Coze 工作流 Token（从 Coze 工作流发布页获取）
# 本地开发：填在 .env.local 中
# 生产环境：在 Cloudflare Dashboard → Pages → escape-type-launcher → Settings → Environment Variables 中设置
COZE_TOKEN=your_coze_workflow_token_here
